{
  "entities": {
    "enquiry": {
      "title": "Customer Enquiry",
      "description": "Vehicle rental or tour enquiry submitted by a customer",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Full name of the customer"
        },
        "phoneNumber": {
          "type": "string",
          "minLength": 5,
          "maxLength": 30,
          "description": "Customer contact phone number"
        },
        "email": {
          "type": "string",
          "maxLength": 100,
          "description": "Optional email address"
        },
        "service": {
          "type": "string",
          "maxLength": 100,
          "description": "Requested rental service"
        },
        "preferredPickupDateTime": {
          "type": "string",
          "maxLength": 100,
          "description": "Optional preferred pickup date and time"
        },
        "preferredReturnDateTime": {
          "type": "string",
          "maxLength": 100,
          "description": "Optional preferred return date and time"
        },
        "location": {
          "type": "string",
          "maxLength": 200,
          "description": "Optional pickup or delivery location"
        },
        "message": {
          "type": "string",
          "minLength": 5,
          "maxLength": 3000,
          "description": "Customer message or requirements"
        },
        "consent": {
          "type": "boolean",
          "description": "Consent for business to contact customer regarding enquiry"
        },
        "status": {
          "type": "string",
          "enum": ["new", "contacted", "closed"],
          "description": "Processing status"
        },
        "notes": {
          "type": "string",
          "maxLength": 1000,
          "description": "Owner internal note"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp ISO string"
        },
        "updatedAt": {
          "type": "string",
          "description": "Update timestamp ISO string"
        }
      },
      "required": ["fullName", "phoneNumber", "service", "message", "consent", "status", "createdAt"]
    },
    "admin": {
      "title": "Admin Profile",
      "description": "Authorized administrator record",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Admin email address"
        },
        "role": {
          "type": "string",
          "enum": ["owner", "admin"],
          "description": "Role level"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp ISO string"
        }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/enquiries/{enquiryId}": {
      "schema": "enquiry",
      "description": "Car rental enquiries submitted by customers"
    },
    "/admins/{userId}": {
      "schema": "admin",
      "description": "Authorized admin users for inbox access"
    }
  }
}
